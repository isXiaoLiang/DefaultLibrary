<UserControl x:Class="_20250113_MVVM_Toolkit_WPF.Test.UclMain"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:_20250113_MVVM_Toolkit_WPF.Test"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.DataContext>
        <local:ViewModel/>
    </UserControl.DataContext>
    <StackPanel>
        <Label Content="{Binding Name}" Width="100" Height="100"></Label>
        <Button Content="Push" Command="{Binding GreetUserCommand}" IsEnabled="{Binding IsGreetUser}" Height="30" Width="100"></Button>
        <Button Content="Pull" Command="{Binding ClearNameCommand}" Height="30" Width="100"></Button>
        <Button Content="使用" Command="{Binding GreetUserCanCommand}" Height="30" Width="100"></Button>
        <Button Content="停止使用" Command="{Binding GreetUserNoCanCommand}" Height="30" Width="100"></Button>
    </StackPanel>
</UserControl>
